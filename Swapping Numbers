a = int(input("Enter the first number: "))
b = int(input("Enter the second number: "))
c = int(input("Enter the third number: "))

print("Before swapping:")
print("a =", a)
print("b =", b)
print("c =", c)

choice = int(input("Enter your choice (1-5): "))


if choice == 1:
    a, c, b = a, c, b
elif choice == 2:
    b, a, c = a, b, c
elif choice == 3:
    b, c, a = a, b, c
elif choice == 4:
    c, a, b = a, b, c
elif choice == 5:
    c, b, a = a, b, c
else:
    print("Does not work")

print("After swapping:")
print("a =", a)
print("b =", b)
print("c =", c)
