class Car:
    def __init__(self,brand,speed):
        self.brand=brand
        self.speed=speed   

    def accelerate(self,amount):
        self.speed += amount

    def show(self):
        print(f"{self.brand} is going at {self.speed} km/h")

c1=Car("Toyota", 100)
c2=Car("Honda", 80)
c1.accelerate(20)
c1.show()
